{
  "manifest_version": 3,
  "name": "entab-D - Groups & Duplicates",
  "version": "1.0.0",
  "description": "Intelligent, lightweight Chrome extension to automatically sort, group, deduplicate, and organize browser tabs.",
  "action": {
    "default_title": "entab-D",
    "default_popup": "src/popup/popup.html"
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background/service_worker.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}